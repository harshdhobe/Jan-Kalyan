{
  "id": "ignwps",
  "name": "Indira Gandhi National Widow Pension Scheme",
  "tier": 1,
  "level": "central",
  "state": null,
  "scope": "person",
  "benefit": "Monthly pension of Rs 300 for widows aged 40-79 below poverty line.",
  "criteria": {
    "all": [
      {
        "field": "gender",
        "op": "==",
        "value": "female"
      },
      {
        "field": "marital_status",
        "op": "==",
        "value": "widowed"
      },
      {
        "field": "age",
        "op": ">=",
        "value": 40
      },
      {
        "field": "age",
        "op": "<=",
        "value": 79
      },
      {
        "field": "household.bpl",
        "op": "==",
        "value": true
      }
    ]
  },
  "documents": [
    "husband_death_certificate",
    "bpl_card",
    "age_proof"
  ],
  "links": {
    "info": "https://www.myscheme.gov.in/schemes/ignwps",
    "apply": "https://nsap.dord.gov.in/Guidelines/wps.pdf"
  },
  "notes": ""
}