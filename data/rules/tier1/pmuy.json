{
  "id": "pmuy",
  "name": "Pradhan Mantri Ujjwala Yojana",
  "tier": 1,
  "level": "central",
  "state": null,
  "scope": "person",
  "benefit": "Free LPG connection with first refill and stove to women from deprived households.",
  "criteria": {
    "all": [
      {
        "field": "gender",
        "op": "==",
        "value": "female"
      },
      {
        "field": "age",
        "op": ">=",
        "value": 18
      },
      {
        "field": "household.has_lpg",
        "op": "==",
        "value": false
      },
      {
        "any": [
          {
            "field": "household.bpl",
            "op": "==",
            "value": true
          },
          {
            "field": "household.is_sc_st",
            "op": "==",
            "value": true
          },
          {
            "field": "household.has_aay_card",
            "op": "==",
            "value": true
          },
          {
            "field": "household.is_pmay_beneficiary",
            "op": "==",
            "value": true
          },
          {
            "field": "household.in_priority_group",
            "op": "==",
            "value": true
          }
        ]
      }
    ]
  },
  "documents": [
    "photo_id",
    "ration_card",
    "address_proof",
    "bank_account"
  ],
  "links": {
    "info": "https://www.myscheme.gov.in/schemes/pmuy",
    "apply": "https://www.pmuy.gov.in/"
  },
  "notes": "'in_priority_group' covers forest dwellers, MBC, tea garden tribes, river island residents. Covers UJJWALA 2.0."
}