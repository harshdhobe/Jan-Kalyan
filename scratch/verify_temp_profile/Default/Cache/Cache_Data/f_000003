/* Jan Kalyan Landing Page Stylesheet
   Strictly adheres to Google Stitch Design Specs & System Tokens
   Source: Jan Kalyan | जन कल्याण (Editorial NGO Redesign)
*/

:root {
  --color-cream: #FAF4EA;
  --color-sand: #F1E4CE;
  --color-deep-brown: #2A1A10;
  --color-terracotta: #A8421E;
  --color-deep-green: #1F4D36;
  --color-trust-green: #1F5A3B;
  --color-shield-border: #2E6B4A;
  --color-hairline: #D6C4A6;
  --color-footer-text: #F5E9D6;

  --font-serif: 'Newsreader', Georgia, serif;
  --font-sans: 'Public Sans', sans-serif;
  --font-devanagari: 'Noto Sans Devanagari', sans-serif;

  --radius-btn: 6px;
  --radius-photo: 4px;
}

/* ==========================================================================
   RESET & GLOBAL RULES
   html, body, #root must have margin 0, padding 0, width 100%, no border,
   no border-radius, background #FAF4EA, text-align left.
   ========================================================================== */
html,
body {
  margin: 0 !important;
  padding: 0 !important;
  width: 100% !important;
  border: none !important;
  border-radius: 0 !important;
  background-color: var(--color-cream) !important;
  text-align: left !important;
  display: block !important;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

#landing-view,
#placeholder-view,
.landing-page-root {
  width: 100% !important;
  max-width: 100% !important;
  margin: 0 !important;
  padding: 0 !important;
  border: none !important;
  border-radius: 0 !important;
  background-color: var(--color-cream);
  text-align: left !important;
  box-sizing: border-box;
  display: block !important;
}

.landing-page-root *,
.landing-page-root *::before,
.landing-page-root *::after {
  box-sizing: border-box;
}

/* Accessible focus ring: 3px terracotta */
.landing-focus-ring:focus-visible,
.landing-btn-cta:focus-visible,
.landing-lang-btn:focus-visible,
.landing-logo:focus-visible,
.landing-page-root a:focus-visible,
.landing-page-root button:focus-visible {
  outline: 3px solid var(--color-terracotta) !important;
  outline-offset: 2px !important;
}

/* Section Anchor Offset for 80px Sticky Header */
.landing-section-wrapper {
  scroll-margin-top: 80px;
}

/* ==========================================================================
   CONTAINER
   Centered in 1200px container at ANY screen width (1280, 1440, 1920)
   Horizontal padding 24px below 1280px width, 0 at 1280px and above.
   ========================================================================== */
.landing-container {
  width: 100% !important;
  max-width: 1200px !important;
  margin-left: auto !important;
  margin-right: auto !important;
  padding-left: 24px !important;
  padding-right: 24px !important;
  display: block !important;
  text-align: left !important;
  box-sizing: border-box;
}

@media (min-width: 1280px) {
  .landing-container {
    padding-left: 0 !important;
    padding-right: 0 !important;
  }
}

/* ==========================================================================
   1. HEADER
   Height exactly 80px. ONE row: logo on left, language switcher on right.
   Sticky, solid #FAF4EA background, bottom border 1px #D6C4A6.
   ========================================================================== */
.landing-header {
  position: sticky;
  top: 0;
  z-index: 50;
  width: 100%;
  height: 80px;
  background-color: var(--color-cream) !important;
  border-bottom: 1px solid var(--color-hairline);
  box-shadow: none;
  margin: 0;
  padding: 0;
}

.landing-header-inner {
  height: 80px;
  display: flex !important;
  flex-direction: row !important;
  align-items: center !important;
  justify-content: space-between !important;
  text-align: left !important;
}

.landing-logo {
  display: flex !important;
  flex-direction: row !important;
  align-items: baseline !important;
  gap: 14px;
  text-decoration: none;
  color: var(--color-deep-brown);
}

.landing-logo-serif {
  font-family: var(--font-serif);
  font-size: 32px;
  font-weight: 600;
  line-height: 1;
  letter-spacing: -0.02em;
  color: var(--color-deep-brown);
}

.landing-logo-divider {
  display: inline-block;
  width: 1px;
  height: 28px;
  background-color: var(--color-hairline);
  align-self: center;
}

.landing-logo-devanagari {
  font-family: var(--font-devanagari);
  font-size: 24px;
  font-weight: 700;
  line-height: 1;
  color: var(--color-deep-brown);
}

/* Language switcher */
.landing-lang-nav {
  display: flex !important;
  flex-direction: row !important;
  align-items: center !important;
  gap: 0;
}

.landing-lang-btn {
  height: 80px;
  min-height: 48px;
  min-width: 48px;
  padding: 0 16px;
  background: transparent;
  border: none;
  font-family: var(--font-sans);
  font-size: 18px;
  font-weight: 500;
  color: var(--color-deep-brown);
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  position: relative;
  border-bottom: 3px solid transparent;
  transition: color 0.15s ease, border-color 0.15s ease;
  box-sizing: border-box;
}

.landing-lang-btn.devanagari {
  font-family: var(--font-devanagari);
}

.landing-lang-btn:hover {
  color: var(--color-deep-brown);
}

.landing-lang-btn.active {
  font-weight: 700;
  color: var(--color-deep-brown);
  border-bottom: 3px solid var(--color-terracotta);
}

/* Devanagari Typography for Hindi & Marathi */
html[lang="hi"] body,
html[lang="mr"] body,
html[lang="hi"] .landing-page-root,
html[lang="mr"] .landing-page-root {
  font-family: var(--font-devanagari);
}

html[lang="hi"] .landing-hero-subheading,
html[lang="mr"] .landing-hero-subheading,
html[lang="hi"] .landing-hero-supporting,
html[lang="mr"] .landing-hero-supporting,
html[lang="hi"] .landing-mission-p,
html[lang="mr"] .landing-mission-p,
html[lang="hi"] .landing-step-text,
html[lang="mr"] .landing-step-text,
html[lang="hi"] .landing-btn-sub,
html[lang="mr"] .landing-btn-sub,
html[lang="hi"] .landing-privacy-note,
html[lang="mr"] .landing-privacy-note,
html[lang="hi"] .landing-footer-text,
html[lang="mr"] .landing-footer-text {
  font-family: var(--font-devanagari);
  line-height: 1.5;
}

html[lang="hi"] .landing-btn-cta .btn-title,
html[lang="mr"] .landing-btn-cta .btn-title {
  font-family: var(--font-devanagari);
  line-height: 1.3;
}

.landing-lang-divider {
  display: inline-block;
  width: 1px;
  height: 24px;
  background-color: var(--color-hairline);
  align-self: center;
}

/* ==========================================================================
   2. HERO SECTION
   Full width wrapper background #FAF4EA.
   Padding: 96px top, 120px bottom.
   Grid: 12-col gap-x-8 items-start.
   Col-span-7 text (≈687px), Col-span-5 photo (≈481px).
   ========================================================================== */
.landing-hero-section {
  width: 100%;
  background-color: var(--color-cream);
  padding-top: 96px;
  padding-bottom: 120px;
}

.landing-hero-grid {
  display: grid;
  grid-template-columns: repeat(12, 1fr);
  column-gap: 32px;
  row-gap: 40px;
  align-items: start;
}

.landing-hero-left {
  grid-column: span 7;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  text-align: left;
}

.landing-hero-eyebrow {
  font-family: var(--font-sans);
  font-size: 16px;
  font-weight: 500;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: rgba(42, 26, 16, 0.8);
  margin: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10px;
  text-align: left;
}

.landing-hero-eyebrow .eyebrow-dot {
  color: var(--color-hairline);
}

.landing-hero-eyebrow .eyebrow-devanagari {
  font-family: var(--font-devanagari);
  letter-spacing: normal;
  font-size: 18px;
  font-weight: 700;
  color: var(--color-deep-brown);
}

.landing-hero-h1 {
  font-family: var(--font-serif);
  font-size: clamp(56px, 7vw, 96px);
  line-height: 1;
  font-weight: 400;
  color: var(--color-deep-brown);
  letter-spacing: -0.02em;
  margin-top: 16px;
  margin-bottom: 24px;
  white-space: nowrap;
  text-align: left;
}

.landing-hero-subheading {
  font-family: var(--font-sans);
  font-size: 24px;
  line-height: 1.4;
  font-weight: 400;
  color: var(--color-deep-brown);
  max-width: 600px;
  margin-top: 0;
  margin-bottom: 0;
  text-align: left;
}

.landing-hero-supporting {
  font-family: var(--font-sans);
  font-size: 20px;
  line-height: 1.5;
  font-weight: 400;
  color: rgba(42, 26, 16, 0.8);
  max-width: 560px;
  margin-top: 16px;
  margin-bottom: 0;
  text-align: left;
}

/* Hero CTA Buttons */
.landing-hero-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
  align-items: stretch;
  width: 100%;
  max-width: 687px;
  margin-top: 40px;
  margin-bottom: 0;
}

.landing-btn-cta {
  min-height: 88px;
  padding: 16px 20px;
  border-radius: var(--radius-btn);
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16px;
  text-decoration: none;
  cursor: pointer;
  text-align: left;
  box-sizing: border-box;
  transition: background-color 0.15s ease, border-color 0.15s ease;
}

.landing-btn-cta svg {
  width: 32px;
  height: 32px;
  flex-shrink: 0;
}

.landing-btn-cta .btn-content {
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
}

.landing-btn-cta .btn-title {
  font-family: var(--font-sans);
  font-size: 22px;
  font-weight: 600;
  line-height: 1.2;
  white-space: nowrap;
}

.landing-btn-cta .btn-sub {
  font-family: var(--font-sans);
  font-size: 15px;
  font-weight: 400;
  line-height: 1.35;
  margin-top: 4px;
  word-break: break-word;
}

/* Primary Button: Deep brown fill, cream text */
.landing-btn-primary {
  background-color: var(--color-deep-brown);
  color: var(--color-cream);
  border: none;
}
.landing-btn-primary svg {
  color: var(--color-cream);
}
.landing-btn-primary .btn-title {
  color: var(--color-cream);
}
.landing-btn-primary .btn-sub {
  color: rgba(250, 244, 234, 0.75);
}
.landing-btn-primary:hover {
  background-color: #3D2719;
}

/* Secondary Button: White fill, 2px terracotta border, deep brown text */
.landing-btn-secondary {
  background-color: #FFFFFF;
  border: 2px solid var(--color-terracotta);
  color: var(--color-deep-brown);
}
.landing-btn-secondary svg {
  color: var(--color-deep-brown);
}
.landing-btn-secondary .btn-title {
  color: var(--color-deep-brown);
}
.landing-btn-secondary .btn-sub {
  color: rgba(42, 26, 16, 0.75);
}
.landing-btn-secondary:hover {
  background-color: var(--color-cream);
}

/* Shield line */
.landing-privacy-note {
  margin-top: 32px;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12px;
  border-left: 3px solid var(--color-shield-border);
  padding-left: 16px;
  font-size: 18px;
  color: var(--color-trust-green);
  font-weight: 500;
  text-align: left;
  white-space: nowrap;
}

.landing-privacy-note svg {
  width: 20px;
  height: 20px;
  color: var(--color-shield-border);
  flex-shrink: 0;
}

/* Photo column: fills 100% width, vertically centered against text block */
.landing-hero-right {
  grid-column: span 5;
  align-self: center;
  width: 100%;
}

.landing-photo-frame {
  width: 100%;
  height: auto;
  border-radius: var(--radius-photo);
  overflow: hidden;
  border: none;
  box-shadow: none;
  background-color: transparent;
  align-self: center;
}

.landing-photo-frame img {
  width: 100%;
  height: auto;
  display: block;
  border-radius: 4px;
  object-fit: fill;
}

/* ==========================================================================
   3. MISSION BAND
   Wrapper background #1F4D36, vertical padding 160px.
   Container: 1200px, content max-width 892px (9 cols), left-aligned.
   ========================================================================== */
.landing-mission-band {
  width: 100%;
  background-color: var(--color-deep-green);
  color: var(--color-cream);
  padding-top: 160px;
  padding-bottom: 160px;
}

.landing-mission-content {
  max-width: 892px;
  margin: 0;
  text-align: left;
}

.landing-mission-h2 {
  font-family: var(--font-serif);
  font-size: 64px;
  line-height: 1.05;
  letter-spacing: -0.02em;
  color: var(--color-cream);
  font-weight: 400;
  margin: 0;
  text-align: left;
}

.landing-mission-p {
  font-family: var(--font-sans);
  font-size: 20px;
  line-height: 1.5;
  font-weight: 400;
  color: rgba(250, 244, 234, 0.9);
  max-width: 640px;
  margin-top: 32px;
  margin-bottom: 0;
  text-align: left;
}

/* ==========================================================================
   4. HOW IT WORKS
   Wrapper background #FAF4EA, vertical padding 120px desktop.
   Title 56px left-aligned, margin-bottom 64px.
   2 equal columns gap-x-20 (80px gap), each ≈560px.
   ========================================================================== */
.landing-how-section {
  width: 100%;
  background-color: var(--color-cream);
  padding-top: 120px;
  padding-bottom: 120px;
}

.landing-section-h2 {
  font-family: var(--font-serif);
  font-size: 56px;
  line-height: 1.0;
  font-weight: 400;
  color: var(--color-deep-brown);
  margin: 0 0 64px 0;
  text-align: left;
  letter-spacing: -0.02em;
}

.landing-how-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  column-gap: 80px;
  align-items: start;
}

.landing-how-col {
  display: flex;
  flex-direction: column;
  width: 100%;
}

.landing-col-accent-1 {
  width: 100%;
  height: 4px;
  background-color: var(--color-deep-brown);
  margin: 0;
}

.landing-col-accent-2 {
  width: 100%;
  height: 4px;
  background-color: var(--color-terracotta);
  margin: 0;
}

.landing-col-header {
  padding-top: 24px;
  padding-bottom: 24px;
  border-bottom: 1px solid var(--color-hairline);
  text-align: left;
}

.landing-col-title {
  font-family: var(--font-serif);
  font-size: 36px;
  font-weight: 400;
  line-height: 1.15;
  color: var(--color-deep-brown);
  margin: 0;
  text-align: left;
}

.landing-col-sub {
  display: block;
  font-family: var(--font-sans);
  font-size: 16px;
  color: rgba(42, 26, 16, 0.7);
  margin-top: 8px;
  margin-bottom: 0;
  text-align: left;
}

.landing-how-list {
  display: flex;
  flex-direction: column;
}

.landing-how-row {
  display: grid;
  grid-template-columns: 56px 1fr 56px;
  align-items: center;
  column-gap: 24px;
  min-height: 120px;
  border-bottom: 1px solid var(--color-hairline);
  padding: 16px 0;
  box-sizing: border-box;
}

.landing-step-num {
  font-family: var(--font-serif);
  font-size: 56px;
  color: var(--color-terracotta);
  line-height: 1;
  font-weight: 400;
  text-align: left;
  user-select: none;
}

.landing-step-text {
  font-family: var(--font-sans);
  font-size: 24px;
  font-weight: 600;
  color: var(--color-deep-brown);
  line-height: 1.3;
  text-align: left;
}

.landing-step-icon {
  width: 56px;
  height: 56px;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.landing-step-icon svg {
  width: 48px;
  height: 48px;
  color: var(--color-deep-brown);
}

/* ==========================================================================
   5. MADE FOR EVERY FAMILY
   Wrapper background #F1E4CE (sand), vertical padding 120px.
   Grid: 12-col gap-x-12. Title col-span-4, groups col-span-8.
   2 sub-columns of 3 rows with hairlines.
   ========================================================================== */
.landing-family-section {
  width: 100%;
  background-color: var(--color-sand);
  padding-top: 120px;
  padding-bottom: 120px;
}

.landing-family-grid {
  display: grid;
  grid-template-columns: repeat(12, 1fr);
  column-gap: 48px;
  align-items: start;
}

.landing-family-title-col {
  grid-column: span 4;
}

.landing-family-title {
  font-family: var(--font-serif);
  font-size: 56px;
  line-height: 1.0;
  font-weight: 400;
  color: var(--color-deep-brown);
  margin: 0;
  text-align: left;
  letter-spacing: -0.02em;
}

.landing-family-list-col {
  grid-column: span 8;
}

.landing-family-items-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  column-gap: 48px;
  border-top: 1px solid var(--color-hairline);
}

.landing-family-item {
  padding-top: 24px;
  padding-bottom: 24px;
  border-bottom: 1px solid var(--color-hairline);
  text-align: left;
}

.landing-family-item-en {
  font-family: var(--font-serif);
  font-size: 28px;
  color: var(--color-deep-brown);
  line-height: 1.2;
  font-weight: 500;
  text-align: left;
}

.landing-family-item-devanagari {
  font-family: var(--font-devanagari);
  font-size: 18px;
  color: rgba(42, 26, 16, 0.85);
  margin-top: 4px;
  font-weight: 700;
  text-align: left;
}

/* ==========================================================================
   6. PROMISES
   Wrapper background #FAF4EA, top & bottom 1px hairline #D6C4A6.
   Vertical padding 48px. 4 equal columns in ONE row separated by vertical lines.
   ========================================================================== */
.landing-promises-section {
  width: 100%;
  background-color: var(--color-cream);
  border-top: 1px solid var(--color-hairline);
  border-bottom: 1px solid var(--color-hairline);
  padding-top: 48px;
  padding-bottom: 48px;
}

.landing-promises-row {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  width: 100%;
}

.landing-promise-item {
  padding: 0 24px;
  font-family: var(--font-sans);
  font-size: 20px;
  font-weight: 600;
  color: var(--color-deep-brown);
  border-right: 1px solid var(--color-hairline);
  text-align: left;
  box-sizing: border-box;
}

.landing-promise-item:first-child {
  padding-left: 0;
}

.landing-promise-item:last-child {
  padding-right: 0;
  border-right: none;
}

/* ==========================================================================
   7. FOOTER
   Wrapper background #2A1A10, vertical padding 80px.
   Container: max-width 768px, text-left.
   Heading 20px semibold #F5E9D6, subline 16px/1.6 #F5E9D6 at 80%.
   Exactly ONE footer on page.
   ========================================================================== */
.landing-footer {
  width: 100%;
  background-color: var(--color-deep-brown);
  color: var(--color-footer-text);
  padding-top: 80px;
  padding-bottom: 80px;
  border-top: 1px solid var(--color-deep-brown);
}

.landing-footer-content {
  max-width: 768px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  text-align: left;
  margin: 0;
}

.landing-footer-heading {
  font-family: var(--font-sans);
  font-size: 20px;
  font-weight: 600;
  color: var(--color-footer-text);
  letter-spacing: -0.01em;
  margin: 0;
  text-align: left;
}

.landing-footer-text {
  font-family: var(--font-sans);
  font-size: 16px;
  line-height: 1.6;
  font-weight: 400;
  color: rgba(245, 233, 214, 0.8);
  margin: 0;
  text-align: left;
}

/* ==========================================================================
   8. PLACEHOLDER VIEWS (#/helper, #/quick-check)
   ========================================================================== */
.landing-placeholder-view {
  min-height: 60vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
  padding: 80px 0;
  text-align: left;
}

.landing-placeholder-title {
  font-family: var(--font-serif);
  font-size: 48px;
  color: var(--color-deep-brown);
  margin-bottom: 24px;
  text-align: left;
}

.landing-back-link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  height: 48px;
  min-width: 48px;
  padding: 0 20px;
  background-color: var(--color-deep-brown);
  color: var(--color-cream);
  text-decoration: none;
  font-weight: 600;
  font-size: 16px;
  border-radius: var(--radius-btn);
  transition: background-color 0.15s ease;
}

.landing-back-link:hover {
  background-color: #3D2719;
}

/* ==========================================================================
   RESPONSIVE DESIGN
   Breakpoints: mobile < 768px, tablet 768 to 1023px, desktop ≥ 1024px.
   Section vertical padding: 120px desktop, 64px mobile.
   Mobile order: header, hero text, buttons, photo, mission band,
                 how it works (columns stacked), groups list, promises (2x2), footer.
   ========================================================================== */

/* Tablet (768px to 1023px) */
@media (max-width: 1023px) {
  .landing-hero-h1 {
    font-size: clamp(64px, 8vw, 96px);
  }
  .landing-hero-grid {
    grid-template-columns: 1fr;
    row-gap: 40px;
  }
  .landing-hero-left {
    grid-column: span 12;
  }
  .landing-hero-right {
    grid-column: span 12;
    max-width: 481px;
  }
  .landing-how-grid {
    grid-template-columns: 1fr;
    gap: 48px;
  }
  .landing-family-grid {
    grid-template-columns: 1fr;
    gap: 32px;
  }
  .landing-family-title-col,
  .landing-family-list-col {
    grid-column: span 12;
  }
}

/* Mobile (< 768px) */
@media (max-width: 767px) {
  /* Header stacked on mobile */
  .landing-header {
    height: auto;
  }
  .landing-header-inner {
    height: auto;
    flex-direction: column !important;
    align-items: flex-start !important;
    padding-top: 16px;
    padding-bottom: 16px;
    gap: 16px;
  }
  .landing-logo-serif {
    font-size: 26px;
  }
  .landing-logo-devanagari {
    font-size: 20px;
  }
  .landing-lang-btn {
    height: 48px;
    padding: 0 12px;
    font-size: 16px;
  }

  /* Section Padding */
  .landing-hero-section,
  .landing-mission-band,
  .landing-how-section,
  .landing-family-section {
    padding-top: 64px;
    padding-bottom: 64px;
  }

  /* Hero Mobile Layout */
  .landing-hero-grid {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .landing-hero-left {
    order: 1;
    width: 100%;
  }
  .landing-hero-h1 {
    font-size: 56px;
    white-space: normal; /* Wrap gracefully if screen is very narrow */
  }
  .landing-hero-actions {
    grid-template-columns: 1fr;
    gap: 16px;
    width: 100%;
  }
  .landing-privacy-note {
    white-space: normal;
  }
  .landing-hero-right {
    order: 2; /* After text + buttons */
    width: 100%;
    max-width: 100%;
  }

  /* Mission Band Mobile */
  .landing-mission-h2 {
    font-size: 40px;
    line-height: 1.1;
  }
  .landing-mission-p {
    font-size: 18px;
    margin-top: 20px;
  }

  /* How It Works Mobile */
  .landing-section-h2 {
    font-size: 40px;
    margin-bottom: 40px;
  }
  .landing-how-row {
    grid-template-columns: 44px 1fr 44px;
    column-gap: 16px;
    min-height: 96px;
  }
  .landing-step-num {
    font-size: 44px;
  }
  .landing-step-text {
    font-size: 20px;
  }
  .landing-step-icon svg {
    width: 36px;
    height: 36px;
  }

  /* Made For Every Family Mobile */
  .landing-family-title {
    font-size: 40px;
  }
  .landing-family-items-grid {
    grid-template-columns: 1fr;
    column-gap: 0;
  }
  .landing-family-item-en {
    font-size: 24px;
  }

  /* Promises Mobile (2x2 grid) */
  .landing-promises-section {
    padding-top: 32px;
    padding-bottom: 32px;
  }
  .landing-promises-row {
    grid-template-columns: 1fr 1fr;
    border-top: 1px solid var(--color-hairline);
    border-left: 1px solid var(--color-hairline);
  }
  .landing-promise-item {
    padding: 20px 16px;
    font-size: 16px;
    border-right: 1px solid var(--color-hairline);
    border-bottom: 1px solid var(--color-hairline);
  }
  .landing-promise-item:first-child {
    padding-left: 16px;
  }
  .landing-promise-item:last-child {
    padding-right: 16px;
    border-right: 1px solid var(--color-hairline);
  }

  /* Footer Mobile */
  .landing-footer {
    padding-top: 64px;
    padding-bottom: 64px;
  }
}
